root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4

[{Makefile,*Makefile}]
indent_style = tab
tab_width = 4

[*.{mak,mk}]
indent_style = tab
tab_width = 4


[*.{cmd,bat}]
end_of_line = crlf

[*.{json,yml,yaml,md,txt,sh,zsh,js,ts}]
indent_size = 2

[{.gitconfig,gitconfig}]
indent_style = tab
tab_width = 4

[*.{ps1,psm1,psd1}]
end_of_line = lf
charset = utf-8-bom
